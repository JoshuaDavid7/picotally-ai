{
  "name": "picotally-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes PicoTally's read-only query tools (expenses, jobs, payments, materials, customer balances, price history) to Claude Desktop, Claude Code and other MCP clients.",
  "type": "module",
  "bin": {
    "picotally-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "license": "SEE LICENSE IN ../LICENSE"
}
